#!/bin/sh
# Restore Marina after a PortMaster service exits, including crashes.
set -u

encoded_port="${1:-}"
case "$encoded_port" in
    *\\x*) port="$(systemd-escape --unescape "$encoded_port")" ;;
    *) port="$encoded_port" ;;
esac
if [ -n "$port" ]; then
    rm -rf "/var/games/saves/ports/$port/.work"
fi

if [ -z "${SWAYSOCK:-}" ]; then
    SWAYSOCK="$(find /run/user/1000 -maxdepth 1 -type s -name 'sway-ipc.*.sock' -print -quit 2>/dev/null)"
fi
[ -n "${SWAYSOCK:-}" ] || exit 0

swaymsg -s "$SWAYSOCK" 'scratchpad show' >/dev/null 2>&1 || true
swaymsg -s "$SWAYSOCK" '[app_id="org.ultramarinelinux.MarinaShell"] fullscreen disable' >/dev/null 2>&1 || true
swaymsg -s "$SWAYSOCK" '[app_id="org.ultramarinelinux.MarinaShell"] focus' >/dev/null 2>&1 || true
