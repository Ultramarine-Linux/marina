[Unit]
Description=PortMaster port %i (contained)
After=graphical-session.target

[Service]
Type=simple
Slice=graphical-apps.slice
PrivateUsers=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
RootDirectory=/run/portmaster/merged/%i
BindReadOnlyPaths=/var/games/ports:/run/portmaster/lower
BindPaths=/var/games/saves/ports/%i:/run/portmaster/upper
BindPaths=/run/user/1000/wayland-1
BindPaths=/dev/dri
BindPaths=/dev/input
BindPaths=/run/user/1000/pipewire-0
DeviceAllow=/dev/dri/renderD128 rw
DeviceAllow=char-input rw
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=WAYLAND_DISPLAY=wayland-1
Environment=CFW_NAME=ROCKNIX
Environment=DISPLAY_WIDTH=720
Environment=DISPLAY_HEIGHT=1280

ExecStartPre=/usr/local/libexec/portmaster-mount-stack %i
ExecStart=/roms/ports/%i.sh
ExecStopPost=/usr/local/libexec/portmaster-unmount-stack %i
Restart=no

# The launcher is expected to clean up its own child processes via pm_finish.
KillMode=mixed
