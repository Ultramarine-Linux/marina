[Unit]
Description=PortMaster port %I (contained)
After=graphical-session.target

[Service]
Type=simple
Slice=graphical-apps.slice
PrivateUsers=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
RuntimeDirectory=portmaster/home
RuntimeDirectoryMode=0755
TemporaryFileSystem=/roms
BindPaths=/var/games/saves/ports

BindPaths=/run/user/1000/wayland-1
BindPaths=/dev/dri
BindPaths=/dev/input
BindPaths=/dev/uinput
BindPaths=/dev/snd
BindPaths=/run/user/1000/pipewire-0
BindPaths=/run/user/1000/pulse:/run/user/1000/pulse
DeviceAllow=/dev/dri/renderD128 rw
DeviceAllow=/dev/uinput rw
DeviceAllow=char-input rw
DeviceAllow=char-sound rw
Environment=PATH=/roms/ports/PortMaster/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/run/user/1000/portmaster/home
Environment=XDG_DATA_HOME=/run/user/1000/portmaster/home/.local/share
Environment=XDG_CONFIG_HOME=/run/user/1000/portmaster/home/.config

Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=WAYLAND_DISPLAY=wayland-1
Environment=PULSE_SERVER=unix:/run/user/1000/pulse/native
Environment=PIPEWIRE_REMOTE=pipewire-0
Environment=CFW_NAME=ROCKNIX
Environment=PORTMASTER_UNIT=portmaster@%i.service
Environment=DISPLAY_WIDTH=720
Environment=DISPLAY_HEIGHT=1280
Environment=RUST_BACKTRACE=full

ExecStart=/usr/local/libexec/portmaster-launch %i
ExecStopPost=/usr/local/libexec/portmaster-restore-marina
Restart=no

# The launcher is expected to clean up its own child processes via pm_finish.
KillMode=mixed
