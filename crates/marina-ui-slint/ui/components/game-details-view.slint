import { ListView } from "std-widgets.slint";
import { Tokens } from "../slintcn/theme/tokens.slint";
import { Button, ButtonVariant, ButtonSize } from "../slintcn/components/button.slint";
import { Skeleton } from "../slintcn/components/skeleton.slint";
import { ScrollArea } from "../slintcn/components/scroll-area.slint";
import { Text as Typography } from "../slintcn/components/text.slint";
import { TextVariant, TextTone } from "../slintcn/components/text.slint";
import { Badge, BadgeSize, BadgeVariant } from "../slintcn/components/badge.slint";
import { CrumbHeader } from "crumb-header.slint";
import { GameCardData } from "card.slint";
import { PreviewDetailsData } from "preview-details.slint";
import { ShellState } from "app-shell.slint";
import { Sheet, SheetSide } from "../slintcn/components/sheet.slint";
import { Card, CardPadding, CardRadius } from "../slintcn/components/card.slint";
import { FocusListScroll } from "focus-list-scroll.slint";
import { MarqueeText } from "../slintcn/components/marquee-text.slint";

export struct LaunchArtifactData {
    name: string,
    size: string,
}

export struct GalleryImageData {
    image: image,
    label: string,
    ratio: float,
}

export global GameState {
    in-out property <GameCardData> selected-game;
    in-out property <PreviewDetailsData> details;
    in-out property <[string]> tags;
    in-out property <[GalleryImageData]> gallery;
    in-out property <[LaunchArtifactData]> launch-artifacts;
    in-out property <bool> launch-sheet-open: false;
    in-out property <int> selected-launch-artifact: 0;
    in-out property <bool> details-loading: false;
    in-out property <string> launching-game-id;
    in-out property <string> playing-game-id;
    callback play-requested(string);
    callback launch-artifact-requested(string, int);
}

export component GameDetailsView inherits Rectangle {
    in property <GameCardData> game;
    in property <PreviewDetailsData> details;
    in property <[string]> tags: [];
    in property <[GalleryImageData]> gallery: [];
    in property <bool> loading: false;
    in property <string> action-label: "Play";
    in property <bool> action-disabled: false;
    in property <int> focus-request: 0;
    private property <int> gallery-selected: 0;
    private property <length> launch-list-scroll-y: 0px;
    private property <length> launch-marquee-offset: 0px;
    private property <int> scroll-focus-request: 0;
    private property <length> scroll-content-height:
        max(root.height, details-content.preferred-height + Tokens.spacing-2xl);
    // Keep the details column aligned while sizing each cover to its natural
    // aspect ratio inside a transparent, fixed-width cover slot.
    private property <float> cover-ratio:
        min(max(root.game.cover-ratio, 0.4), 2.0);
    private property <length> cover-width: 220px;
    private property <length> cover-slot-height: 220px;
    private property <length> cover-image-height:
        min(root.cover-slot-height,
            max(120px, root.cover-width / root.cover-ratio));
    callback action-requested;
    callback focus-header;

    background: transparent;
    forward-focus: action-button;
    // All focus moves defer past mount settling: `focus-request` can already
    // be nonzero on remount, and a synchronous grab inside setup can run
    // within an accessibility tree rebuild and panic the backend. A timer
    // always lands on a clean stack.
    init => { focus-defer-timer.start(); }
    changed focus-request => {
        focus-defer-timer.stop();
        focus-defer-timer.start();
    }
    changed gallery => { root.gallery-selected = 0; }

    focus-defer-timer := Timer {
        interval: 50ms;
        triggered => {
            self.stop();
            action-button.focus();
        }
    }

    gallery-focus := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if (event.text == Key.LeftArrow) {
                root.gallery-selected = max(0, root.gallery-selected - 1);
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.gallery-selected = min(root.gallery.length - 1, root.gallery-selected + 1);
                return accept;
            }
            if (event.text == Key.UpArrow) {
                action-button.focus();
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.scroll-focus-request += 1;
                return accept;
            }
            return reject;
        }
    }

    VerticalLayout {
        spacing: Tokens.spacing-md;
        // The trail already ends in the game title; a title row would
        // duplicate it (and the content below shows the title anyway).
        CrumbHeader {
            crumbs: ShellState.breadcrumbs;
            crumb-navigate(index) => { ShellState.crumb-navigate(index); }
        }

        ScrollArea {
            width: parent.width;
            focus-request: root.scroll-focus-request;
            focus-content => { action-button.focus(); }
            vertical-stretch: 1;
            content-height: root.scroll-content-height;
            details-content := VerticalLayout {
                height: root.scroll-content-height;
                padding-left: Tokens.spacing-2xl;
                padding-right: Tokens.spacing-2xl;
                padding-bottom: Tokens.spacing-2xl;
                spacing: Tokens.spacing-lg;
                HorizontalLayout {
                    height: root.cover-slot-height;
                    spacing: Tokens.spacing-lg;
                    details-cover := Rectangle {
                        width: root.cover-width;
                        height: root.cover-slot-height;
                        clip: true;
                        if root.game.cover.width == 0: Skeleton {
                            y: (parent.height - root.cover-image-height) / 2;
                            width: parent.width;
                            height: root.cover-image-height;
                            radius: Tokens.radius-md;
                        }
                        if root.game.cover.width > 0: Image {
                            y: (parent.height - root.cover-image-height) / 2;
                            width: parent.width;
                            height: root.cover-image-height;
                            source: root.game.cover;
                            image-fit: contain;
                        }
                    }
                    VerticalLayout {
                        width: parent.width - details-cover.width - Tokens.spacing-lg;
                        spacing: Tokens.spacing-md;
                        Typography {
                            width: parent.width;
                            text: root.loading
                                ? root.game.title
                                : (root.details.title != "" ? root.details.title : root.game.title);
                            variant: TextVariant.headline;
                            overflow: clip;
                        }
                        Typography { text: root.game.platform; variant: TextVariant.body-lg; tone: TextTone.muted; }
                        action-button := Button {
                            width: 150px;
                            text: root.action-label;
                            disabled: root.action-disabled;
                            directional-navigation: true;
                            navigation-requested(direction) => {
                                if (direction == "up") {
                                    root.focus-header();
                                } else if (direction == "down") {
                                    if (root.gallery.length > 0) {
                                        gallery-focus.focus();
                                    } else {
                                        root.scroll-focus-request += 1;
                                    }
                                }
                            }
                            clicked => { root.action-requested(); }
                        }
                        if root.tags.length > 0: HorizontalLayout {
                            spacing: Tokens.spacing-xs;
                            for tag in root.tags: Badge {
                                text: tag;
                                variant: BadgeVariant.outline;
                                size: BadgeSize.sm;
                            }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
                if root.gallery.length > 0: VerticalLayout {
                    spacing: Tokens.spacing-sm;
                    Typography { text: "Gallery"; variant: TextVariant.title; }
                    Rectangle {
                        height: 148px;
                        clip: true;

                        gallery-scroll := Flickable {
                            width: parent.width;
                            height: parent.height;
                            viewport-width: gallery-row.preferred-width;
                            viewport-height: parent.height;
                            gallery-row := HorizontalLayout {
                                height: parent.height;
                                spacing: Tokens.spacing-sm;
                                for asset[i] in root.gallery: Rectangle {
                                    width: 132px * min(max(asset.ratio, 0.8), 1.8);
                                    height: parent.height;
                                    border-radius: Tokens.radius-md;
                                    border-width: gallery-focus.has-focus && i == root.gallery-selected
                                        ? Tokens.focus-ring-width
                                        : 0px;
                                    border-color: Tokens.color-ring;
                                    clip: true;
                                    private property <bool> selected: i == root.gallery-selected;
                                    changed selected => {
                                        if (self.selected) {
                                            if (self.x + gallery-scroll.viewport-x < 0px) {
                                                gallery-scroll.viewport-x = -self.x;
                                            } else if (self.x + self.width + gallery-scroll.viewport-x > gallery-scroll.width) {
                                                gallery-scroll.viewport-x = min(0px, gallery-scroll.width - self.x - self.width);
                                            }
                                        }
                                    }
                                    Image {
                                        width: parent.width;
                                        height: parent.height;
                                        source: asset.image;
                                        image-fit: contain;
                                    }
                                }
                            }
                        }
                    }
                }
                Typography { text: root.loading ? "Loading details..." : "Description"; variant: TextVariant.title; }
                Typography {
                    text: root.loading ? "Loading details..." : (root.details.summary != "" ? root.details.summary : "No description available for this game yet.");
                    variant: TextVariant.body-lg;
                    tone: TextTone.muted;
                    wrap: word-wrap;
                }
                VerticalLayout {
                    spacing: Tokens.spacing-sm;
                    if root.details.released-at != "": Typography { text: "Released: " + root.details.released-at; variant: TextVariant.body-sm; }
                    if root.details.languages != "": Typography { text: "Languages: " + root.details.languages; variant: TextVariant.body-sm; tone: TextTone.muted; }
                    if root.details.regions != "": Typography { text: "Regions: " + root.details.regions; variant: TextVariant.body-sm; tone: TextTone.muted; }

                }
                Rectangle { vertical-stretch: 1; }
            }
        }
    }

    Sheet {
        open <=> GameState.launch-sheet-open;
        side: SheetSide.right;
        panel-extent: 440px;
        compact: true;
        auto-focus: false;
        title: "Choose game file";
        description: "Select the artifact to launch";
        opened => {
            GameState.selected-launch-artifact = 0;
            root.launch-list-scroll-y = 0px;
            root.launch-marquee-offset = 0px;
            launch-focus-timer.start();
            launch-marquee-timer.start();
        }
        dismissed => { GameState.launch-sheet-open = false; }

        launch-focus := FocusScope {
            width: 0px;
            height: 0px;
            key-pressed(event) => {
                if (event.text == Key.UpArrow) {
                    GameState.selected-launch-artifact = max(0, GameState.selected-launch-artifact - 1);
                    root.launch-marquee-offset = 0px;
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    GameState.selected-launch-artifact = min(GameState.launch-artifacts.length - 1, GameState.selected-launch-artifact + 1);
                    root.launch-marquee-offset = 0px;
                    return accept;
                }
                if ((event.text == "\n" || event.text == " ") && GameState.launch-artifacts.length > 0) {
                    GameState.launch-sheet-open = false;
                    GameState.launch-artifact-requested(root.game.id, GameState.selected-launch-artifact);
                    return accept;
                }
                if (event.text == "\u{1b}") {
                    GameState.launch-sheet-open = false;
                    action-button.focus();
                    return accept;
                }
                return reject;
            }
        }
        launch-focus-timer := Timer {
            interval: 50ms;
            triggered => {
                self.stop();
                launch-focus.focus();
            }
        }
        launch-marquee-timer := Timer {
            interval: 24ms;
            triggered => {
                if (GameState.launch-sheet-open) {
                    root.launch-marquee-offset += 1px;
                } else {
                    self.stop();
                }
            }
        }

        launch-body := VerticalLayout {
            vertical-stretch: 1;
            padding-left: Tokens.spacing-lg;
            padding-right: Tokens.spacing-lg;

            Card {
                vertical-stretch: 1;
                background: Tokens.color-background;
                card-padding: CardPadding.none;
                card-radius: CardRadius.md;
                clip: true;

                launch-list-scroll := FocusListScroll {
                    selected-index: GameState.selected-launch-artifact;
                    item-count: GameState.launch-artifacts.length;
                    item-height: 48px;
                    viewport-height: launch-list.height;
                    viewport-y <=> root.launch-list-scroll-y;
                }

                launch-list := ListView {
                    width: parent.width;
                    height: parent.height;
                    viewport-y <=> root.launch-list-scroll-y;
                    for artifact[i] in GameState.launch-artifacts: Rectangle {
                        width: parent.width;
                        height: 48px;
                        background: i == GameState.selected-launch-artifact
                            ? Tokens.color-surface-3
                            : transparent;
                        border-radius: Tokens.radius-sm;
                        border-width: launch-focus.has-focus && i == GameState.selected-launch-artifact
                            ? Tokens.focus-ring-width
                            : 0px;
                        border-color: Tokens.color-ring-muted;

                        HorizontalLayout {
                            padding-left: Tokens.spacing-md;
                            padding-right: Tokens.spacing-md;
                            spacing: Tokens.spacing-sm;
                            Rectangle {
                                min-width: 250px;
                                horizontal-stretch: 1;
                                clip: true;
                                MarqueeText {
                                    width: parent.width;
                                    height: parent.height;
                                    text: artifact.name;
                                    active: launch-focus.has-focus
                                        && i == GameState.selected-launch-artifact;
                                    scroll-offset: root.launch-marquee-offset;
                                    font-size: Tokens.typography-body-size;
                                }
                            }
                            Text {
                                width: 72px;
                                text: artifact.size;
                                color: Tokens.color-muted-foreground;
                                font-size: Tokens.typography-label-size;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                GameState.selected-launch-artifact = i;
                                GameState.launch-sheet-open = false;
                                GameState.launch-artifact-requested(root.game.id, i);
                            }
                        }
                    }
                }
            }
        }
    }
}
