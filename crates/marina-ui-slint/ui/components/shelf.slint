import { Tokens } from "../slintcn/theme/tokens.slint";
import { Skeleton } from "../slintcn/components/skeleton.slint";
import { Text as Typography } from "../slintcn/components/text.slint";
import { TextVariant } from "../slintcn/components/text.slint";
import { GameCard, GameCardData } from "card.slint";

export global HomeState {
    in-out property <[GameCardData]> games;
    in-out property <[GameCardData]> played-games;
    in-out property <bool> loading: true;
    in-out property <int> selected-game-index: 0;
    in-out property <int> selected-played-index: 0;
    // 0 = recently played, 1 = recently added.
    in-out property <int> active-shelf: 0;
    callback viewport-changed(length, length, length);
    callback cover-context-changed(int);
    callback entered;
    callback game-opened(string);
}

export component ShelfSkeleton inherits Rectangle {
    in property <length> content-height;
    in property <length> cover-height;

    background: transparent;

    VerticalLayout {
        spacing: Tokens.spacing-sm;

        Rectangle {
            height: 32px;
            Typography {
                x: Tokens.spacing-2xl;
                width: parent.width - 2 * Tokens.spacing-2xl;
                height: parent.height;
                text: "Recently added";
                variant: TextVariant.title;
                vertical-alignment: center;
            }
        }

        Rectangle {
            height: root.content-height;
            clip: true;

            HorizontalLayout {
                padding-left: Tokens.spacing-2xl;
                padding-right: Tokens.spacing-2xl;
                padding-top: Tokens.spacing-sm;
                padding-bottom: Tokens.spacing-sm;
                spacing: Tokens.spacing-lg;

                for _ in 6: Skeleton {
                    width: root.cover-height;
                    height: root.cover-height + 36px;
                    radius: Tokens.radius-lg;
                }
            }
        }
    }
}

export component Shelf inherits Rectangle {
    in property <string> title;
    in property <[GameCardData]> games;
    in property <length> content-height;
    in property <length> cover-height;
    in-out property <int> selected-index: 0;
    in property <int> focus-request: 0;
    // Inactive shelves stay on screen below the active one, dimmed.
    in property <bool> active: true;
    callback viewport-changed(length, length, length);
    callback game-opened(string);
    callback focus-up;
    callback focus-down;
    callback scroll-into-view(length, length);

    background: transparent;
    opacity: root.active ? 1.0 : 0.4;
    animate opacity { duration: 150ms; }
    animate y { duration: 200ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
    forward-focus: shelf-focus;
    changed active => { if (root.active) { shelf-focus.focus(); } }
    changed focus-request => { if (root.active) { shelf-focus.focus(); } }
    scroll-into-view(x, w) => {
        if (x + flick.viewport-x < Tokens.spacing-2xl) {
            flick.viewport-x = max(flick.width - root.content-width, Tokens.spacing-2xl - x);
        } else if (x + w + flick.viewport-x > flick.width - Tokens.spacing-2xl) {
            flick.viewport-x = min(0px, max(flick.width - root.content-width, flick.width - Tokens.spacing-2xl - x - w));
        }
    }

    shelf-focus := FocusScope {
        init => { if (root.active) { shelf-focus.focus(); } }
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if (!root.active) {
                return reject;
            }
            if (event.text == Key.LeftArrow || event.text == "ScrollLeft") {
                if (root.games.length > 0) {
                    if (event.text == Key.LeftArrow) {
                        root.selected-index = max(0, root.selected-index - 1);
                    } else {
                        flick.viewport-x = min(0px, flick.viewport-x + root.cover-height + Tokens.spacing-lg);
                    }
                }
                return accept;
            }
            if (event.text == Key.RightArrow || event.text == "ScrollRight") {
                if (root.games.length > 0) {
                    if (event.text == Key.RightArrow) {
                        root.selected-index = min(root.games.length - 1, root.selected-index + 1);
                    } else {
                        flick.viewport-x = max(flick.width - root.content-width, flick.viewport-x - root.cover-height - Tokens.spacing-lg);
                    }
                }
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.focus-up();
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.focus-down();
                return accept;
            }
            if ((event.text == "\n" || event.text == " ") && root.games.length > 0) {
                root.game-opened(root.games[root.selected-index].id);
                return accept;
            }
            return reject;
        }
    }

    // The layout's intrinsic width — exact even with per-card widths varying
    // by cover aspect ratio.
    private property <length> content-width: row.preferred-width;

    VerticalLayout {
        spacing: Tokens.spacing-sm;

        Rectangle {
            height: 32px;
            Typography {
                x: Tokens.spacing-2xl;
                width: parent.width - 2 * Tokens.spacing-2xl;
                height: parent.height;
                text: root.title;
                variant: TextVariant.title;
                vertical-alignment: center;
            }
        }

        Rectangle {
            height: root.content-height;
            clip: true;

            flick := Flickable {
                width: parent.width;
                height: parent.height;
                viewport-height: parent.height;
                viewport-width: root.content-width;
                animate viewport-x { duration: 200ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
                changed viewport-x => { root.viewport-changed(self.viewport-x, self.width, root.cover-height); }
                changed width => { root.viewport-changed(self.viewport-x, self.width, root.cover-height); }
                changed viewport-width => { root.viewport-changed(self.viewport-x, self.width, root.cover-height); }
                init => { root.viewport-changed(self.viewport-x, self.width, root.cover-height); }

                row := HorizontalLayout {
                    padding-left: Tokens.spacing-2xl;
                    padding-right: Tokens.spacing-2xl;
                    padding-top: Tokens.spacing-sm;
                    padding-bottom: Tokens.spacing-sm;
                    spacing: Tokens.spacing-lg;
                    alignment: start;

                    for game[i] in root.games: Rectangle {
                        width: card.width;
                        background: transparent;

                        private property <bool> selected: i == root.selected-index;
                        changed selected => {
                            if (self.selected) {
                                root.scroll-into-view(self.x, self.width);
                            }
                        }
                        changed x => {
                            if (self.selected) {
                                root.scroll-into-view(self.x, self.width);
                            }
                        }

                        card := GameCard {
                            y: parent.height - self.height;
                            title: game.title;
                            platform: game.platform;
                            cover-image: game.cover;
                            cover-aspect-ratio: game.cover_ratio;
                            cover-height-scale: root.cover-height;
                            keyboard-focused: shelf-focus.has-focus && i == root.selected-index;
                            clicked => {
                                root.selected-index = i;
                                shelf-focus.focus();
                                root.game-opened(game.id);
                            }
                        }
                    }
                }
            }

            if root.content-width > flick.width: Rectangle {
                x: 4px;
                y: parent.height - 8px;
                width: parent.width - 8px;
                height: 6px;
                background: transparent;

                Rectangle {
                    y: 0;
                    height: parent.height;
                    width: max(24px, flick.width * flick.width / root.content-width);
                    x: -flick.viewport-x * flick.width / root.content-width;
                    background: Tokens.color-border-hairline-strong;
                    border-radius: 3px;
                }
            }
        }
    }
}
