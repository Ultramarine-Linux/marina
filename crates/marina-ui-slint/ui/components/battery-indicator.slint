import { Tokens } from "../slintcn/theme/tokens.slint";
import { Text as Typography } from "../slintcn/components/text.slint";
import { TextVariant, TextTone } from "../slintcn/components/text.slint";
import { LucideIcon } from "../slintcn/components/lucide-icon.slint";
import { IconSet } from "@lucide/lucide.slint";

// Battery level view for the AppShell top bar. Percentage is 0–100;
// `charging` reflects UPower Device State == Charging.
//
// The root is an explicit-height container box: it matches the top-bar
// control density so the row centers as one unit, and its width follows
// the content. Items use tight spacing so the glyph, label, and charging
// bolt read as a single cluster.
export component BatteryIndicator inherits Rectangle {
    in property <float> percentage: 100;
    in property <bool> charging: false;

    private property <float> clamped: min(max(root.percentage, 0), 100);
    private property <bool> low: root.clamped <= 20 && !root.charging;
    private property <color> fill-color:
        root.charging ? Tokens.color-affirm :
        root.low ? Tokens.color-destructive :
        Tokens.color-foreground;
    private property <string> label: Math.round(root.clamped) + "%";

    accessible-role: text;
    accessible-label: charging ? "Battery " + label + ", charging" : "Battery " + label;
    background: transparent;

    height: Tokens.density-button-default;
    width: row.preferred-width;
    clip: true;

    row := HorizontalLayout {
        x: 0px;
        // Fixed content height shared by every child below, so the cluster
        // stays on one center line no matter how the layout positions
        // children on the cross axis. No self-reference: keeps the binding
        // loop-free.
        height: 13px;
        y: (parent.height - 13px) / 2;
        width: parent.width;
        spacing: Tokens.spacing-xs;
        alignment: start;

        label_text := Typography {
            text: root.label;
            height: 13px;
            variant: TextVariant.label;
            tone: root.low ? TextTone.danger : TextTone.muted;
            vertical-alignment: center;
        }

        // Battery outline + nub, drawn with layout primitives so the fill
        // level tracks `percentage` continuously.
        glyph := Rectangle {
            width: 26px;
            height: 13px;
            background: transparent;

            HorizontalLayout {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                spacing: 0px;
                
                alignment: center;

                Rectangle {
                    width: 23px;
                    height: 13px;
                    border-width: 1px;
                    border-color: Tokens.color-muted-foreground;
                    border-radius: 3px;
                    background: transparent;
                    clip: true;

                    Rectangle {
                        x: 2px;
                        y: 2px;
                        width: (parent.width - 4px) * (root.clamped / 100);
                        height: parent.height - 4px;
                        border-radius: 1px;
                        background: root.fill-color;
                        animate width {
                            duration: Tokens.motion-base;
                            easing: Tokens.motion-easing-standard;
                        }
                    }
                }

                Rectangle {
                    width: 3px;
                    height: parent.height;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 2px;
                            height: 5px;
                            border-radius: 1px;
                            background: Tokens.color-muted-foreground;
                        }
                    }
                }
            }
        }

        if root.charging: bolt := LucideIcon {
            icon: IconSet.Zap;
            size: 13px;
            height: 13px;
            tint: Tokens.color-affirm;
        }
    }
}
