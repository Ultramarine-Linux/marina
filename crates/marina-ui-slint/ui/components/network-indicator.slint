import { Tokens } from "../slintcn/theme/tokens.slint";
import { LucideIcon } from "../slintcn/components/lucide-icon.slint";
import { IconSet } from "@lucide/lucide.slint";

// Network applet state. Detailed network selection belongs in Settings.
export global NetworkState {
    // False while NetworkManager is unavailable; the applet occupies no space.
    in-out property <bool> available: false;
    in-out property <bool> connected: false;
    // 0–100 for an active Wi-Fi connection, or -1 when the active connection
    // is wired/VPN or NetworkManager does not report a Wi-Fi signal level.
    in-out property <int> signal-strength: -1;
}

// Network connectivity view for the AppShell top bar. State is colocated here
// rather than forwarded through the shell, keeping the shell chrome generic.
export component NetworkIndicator inherits Rectangle {
    accessible-role: text;
    accessible-label: !NetworkState.connected ? "Network disconnected" :
        NetworkState.signal-strength < 0 ? "Network connected" :
        "Network connected, Wi-Fi signal " + NetworkState.signal-strength + "%";
    background: transparent;
    visible: NetworkState.available;
    width: NetworkState.available ? 18px : 0px;
    height: Tokens.density-button-default;

    LucideIcon {
        x: 0px;
        y: (parent.height - self.height) / 2;
        icon: !NetworkState.connected ? IconSet.WifiOff :
            NetworkState.signal-strength < 0 ? IconSet.Wifi :
            NetworkState.signal-strength == 0 ? IconSet.WifiZero :
            NetworkState.signal-strength < 50 ? IconSet.WifiLow :
            NetworkState.signal-strength < 100 ? IconSet.WifiHigh :
            IconSet.Wifi;
        size: 18px;
        tint: NetworkState.connected ? Tokens.color-foreground : Tokens.color-muted-foreground;
    }
}
