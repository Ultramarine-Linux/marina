import { Tokens } from "../slintcn/theme/tokens.slint";
import { Card, CardVariant, CardPadding, CardRadius } from "../slintcn/components/card.slint";
import { Skeleton } from "../slintcn/components/skeleton.slint";
import { Text as Typography } from "../slintcn/components/text.slint";
import { TextVariant, TextTone } from "../slintcn/components/text.slint";

export struct GameCardData {
    id: string,
    title: string,
    platform: string,
    cover: image,
    cover_ratio: float,
}

export component GameCard inherits Card {
    callback clicked;
    in property <string> title;
    in property <string> platform;
    in property <image> cover-image;
    // Derived from the cover image's intrinsic dimensions by the Rust loader.
    // Falls back to 1:1 square until a cover is loaded.
    in property <float> cover-aspect-ratio: 1.0;
    // Uniform cover height: every cover scales to this and varies in width
    // instead. Wide covers (US SNES, JP GBA) get wide cards — cheap on a
    // horizontal shelf — while tall covers (JP SFC) stay bounded.
    // Keep in sync with COVER_HEIGHT in shelf.rs.
    in property <length> cover-height-scale: 200px;
    in property <bool> keyboard-focused: false;

    // Extreme ratios are clamped so a stray banner or scan can't blow the
    // row apart; image-fit: cover crops the overflow instead.
    private property <float> clamped-ratio:
        min(max(root.cover-aspect-ratio, 0.4), 2.0);
    private property <length> cover-height: root.cover-height-scale;
    private property <length> cover-width: root.cover-height * root.clamped-ratio;

    card-padding: CardPadding.none;
    card-radius: CardRadius.lg;
    variant: CardVariant.raised;
    border-width: root.keyboard-focused ? Tokens.focus-ring-width : 1px;
    border-color: root.keyboard-focused ? Tokens.color-ring : Tokens.color-border-hairline;

    // Card width follows the cover: narrow for tall JP boxart, wide for
    // landscape covers, square for placeholders.
    width: root.cover-width;
    height: root.cover-height + 58px;
    clip: true;

    if root.cover-image.width == 0: Skeleton {
        y: 0;
        width: root.cover-width;
        height: root.cover-height;
        radius: 0px;
    }
    if root.cover-image.width > 0: Image {
        y: 0;
        source: root.cover-image;
        width: root.cover-width;
        height: root.cover-height;
        image-fit: cover;
    }

    game-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Rectangle {
        y: parent.height - 58px;
        width: parent.width;
        height: 58px;
        background: Tokens.color-card;

        VerticalLayout {
            padding-left: Tokens.spacing-md;
            padding-right: Tokens.spacing-md;
            padding-top: Tokens.spacing-sm;
            padding-bottom: Tokens.spacing-sm;
            spacing: Tokens.spacing-xs;

            Typography {
                text: root.title;
                variant: TextVariant.body-lg;
                overflow: elide;
            }

            Typography {
                text: root.platform;
                variant: TextVariant.label;
                tone: TextTone.muted;
            }
        }
    }
}
