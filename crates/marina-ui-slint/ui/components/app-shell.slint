import { Tokens } from "../slintcn/theme/tokens.slint";

import { Avatar } from "../slintcn/components/avatar.slint";
import { NavigationMenu, NavigationItem } from "../slintcn/components/navigation-menu.slint";
import { Text as Typography } from "../slintcn/components/text.slint";
import { TextVariant, TextTone } from "../slintcn/components/text.slint";
import { BreadcrumbItem } from "../slintcn/components/breadcrumb.slint";
import { BatteryIndicator } from "battery-indicator.slint";
import { ShellPage } from "../pages/route.slint";

export global ShellState {
    in-out property <ShellPage> page: ShellPage.home;
    in-out property <int> active-tab: 0;
    in-out property <string> search-query;
    in-out property <string> profile-name: "User";
    in-out property <string> profile-username: "user";
    in-out property <string> profile-initials: "U";
    in-out property <image> profile-image;
    in-out property <int> content-focus-request: 0;
    // UPower DisplayDevice state. `battery-available` is false when no
    // battery is present (e.g. desktop) or UPower is unreachable; the
    // indicator stays hidden in that case.
    in-out property <bool> battery-available: false;
    in-out property <float> battery-percentage: 100;
    in-out property <bool> battery-charging: false;
    // Local time (`HH:MM`, or 12-hour when configured) for the top-right
    // digital clock.
    in-out property <string> clock-time: "--:--";
    // Navigation trail; the last item is the current location.
    in-out property <[BreadcrumbItem]> breadcrumbs;
    callback navigate(int);
    callback back-requested;
    callback crumb-navigate(int);
}

// Shared application chrome. Screens are supplied as children and are kept
// separate from shell navigation state.
export component AppShell inherits Rectangle {
    in property <[NavigationItem]> navigation-items;
    in property <string> profile-name: "User";
    in property <string> profile-username: "user";
    in property <string> profile-initials: "U";
    in property <image> profile-image;
    in-out property <int> active-tab: 0;
    in-out property <string> search-query;
    in property <bool> battery-available: false;
    in property <float> battery-percentage: 100;
    in property <bool> battery-charging: false;
    in property <string> clock-time: "--:--";
    callback navigate(int);
    callback focus-content;

    background: Tokens.color-background.with-alpha(0.92);
    forward-focus: navigation;

    VerticalLayout {
        // Only persistent shell chrome owns the outer padding. Routed pages
        // fill the body and choose their own inset/full-bleed treatment.
        Rectangle {
            height: Tokens.spacing-2xl + Tokens.density-button-default + Tokens.spacing-2xl;

            // Allocate three equal regions so each chrome element can anchor
            // independently: profile left, navigation center, spacer right.
            Rectangle {
                x: Tokens.spacing-2xl;
                y: Tokens.spacing-2xl;
                width: parent.width - 2 * Tokens.spacing-2xl;
                height: Tokens.density-button-default;

                HorizontalLayout {
                    spacing: 0px;

                    Rectangle {
                        min-width: 0px;
                        preferred-width: 0px;
                        horizontal-stretch: 1;
                        height: parent.height;
                        clip: true;

                        HorizontalLayout {
                            spacing: Tokens.spacing-sm;
                            alignment: start;

                            Avatar {
                                source: root.profile-image;
                                fallback: root.profile-initials;
                                size: Tokens.density-button-default;
                            }

                            VerticalLayout {
                                alignment: center;

                                Typography {
                                    text: root.profile-name;
                                    variant: TextVariant.body;
                                    tone: TextTone.default;
                                    overflow: elide;
                                }

                                Typography {
                                    text: root.profile-username;
                                    variant: TextVariant.caption;
                                    tone: TextTone.muted;
                                    overflow: elide;
                                }
                            }
                        }
                    }

                    Rectangle {
                        min-width: 0px;
                        preferred-width: 0px;
                        horizontal-stretch: 1;
                        height: parent.height;
                        clip: true;

                        navigation := NavigationMenu {
                            width: self.preferred-width;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            items: root.navigation-items;
                            active <=> root.active-tab;
                            navigate(index) => {
                                root.active-tab = index;
                                root.navigate(index);
                            }
                            focus-content => { root.focus-content(); }
                        }
                    }

                    // Right region balancing the profile region so the
                    // navigation stays centered. Hosts the battery level
                    // view and digital clock end-aligned; the battery is
                    // empty on devices without one.
                    Rectangle {
                        min-width: 0px;
                        preferred-width: 0px;
                        horizontal-stretch: 1;
                        height: parent.height;
                        clip: true;

                        HorizontalLayout {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: parent.height;
                            spacing: Tokens.spacing-md;
                            alignment: end;

                            if root.battery-available: BatteryIndicator {
                                percentage: root.battery-percentage;
                                charging: root.battery-charging;
                            }

                            // Fills the row height like the battery box above:
                            // HorizontalLayout top-aligns children, so equal
                            // heights are what keep both on one center line.
                            clock_label := Typography {
                                text: root.clock-time;
                                height: Tokens.density-button-default;
                                variant: TextVariant.label;
                                tone: TextTone.muted;
                                vertical-alignment: center;
                                font-size: 18px;
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            @children
        }


    }
}
