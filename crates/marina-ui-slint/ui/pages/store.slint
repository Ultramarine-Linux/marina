import { ListView } from "std-widgets.slint";
import { Tokens } from "../slintcn/theme/tokens.slint";
import { Button, ButtonVariant, ButtonSize } from "../slintcn/components/button.slint";
import { Input } from "../slintcn/components/input.slint";
import { Skeleton } from "../slintcn/components/skeleton.slint";
import { Text as Typography } from "../slintcn/components/text.slint";
import { TextVariant, TextTone } from "../slintcn/components/text.slint";
import { ScrollArea } from "../slintcn/components/scroll-area.slint";
import { Sheet, SheetSide } from "../slintcn/components/sheet.slint";
import { Checkbox } from "../slintcn/components/checkbox.slint";
import { Card, CardPadding, CardRadius } from "../slintcn/components/card.slint";
import { Badge, BadgeSize, BadgeVariant } from "../slintcn/components/badge.slint";
import { PlatformCardData } from "../components/platform-card.slint";
import { GameCardData } from "../components/card.slint";
import { PlatformGameList } from "../components/platform-game-list.slint";
import { PreviewDetailsData } from "../components/preview-details.slint";
import { GameDetailsView } from "../components/game-details-view.slint";
import { LucideIcon } from "../slintcn/components/lucide-icon.slint";
import { IconSet } from "@lucide/lucide.slint";

export struct StoreArtifact {
    path: string,
    size: string,
    depth: int,
    is-directory: bool,
    file-index: int,
}

export component StorePage inherits Rectangle {
    in property <[PlatformCardData]> platforms;
    in property <[GameCardData]> games;
    in property <PreviewDetailsData> details;
    in property <image> preview-image;
    in property <[StoreArtifact]> artifacts;
    in-out property <[bool]> selected-artifacts;
    in-out property <int> page: 0;
    in-out property <int> selected-game-index: 0;
    in-out property <int> selected-artifact-index: 0;
    in-out property <string> search-query;
    in-out property <string> selected-platform;
    in-out property <string> selected-platform-name;
    in-out property <int> selected-platform-index: 0;
    in property <int> focus-request: 0;
    private property <length> platform-list-scroll-y: 0px;
    in-out property <length> game-list-scroll-y: 0px;
    in-out property <bool> loading: false;
    in-out property <bool> details-loading: false;
    in-out property <string> install-status;
    in-out property <float> install-progress: 0;
    in-out property <bool> artifact-sheet-open: false;

    callback platform-query(string);
    callback game-selected(string, int);
    callback artifact-selected(int);
    callback install-requested(string, [bool]);
    callback search-requested(string);
    callback focus-header;

    background: transparent;
    forward-focus: page-focus;
    changed focus-request => { page-focus.focus(); }

    function select-platform(index: int) {
        if (root.platforms.length <= 0) { return; }
        root.selected-platform-index = min(max(index, 0), root.platforms.length - 1);

        if (root.selected-platform-index * 52px < -root.platform-list-scroll-y) {
            root.platform-list-scroll-y = -root.selected-platform-index * 52px;
        } else if ((root.selected-platform-index + 1) * 52px > -root.platform-list-scroll-y + root.height - 98px) {
            root.platform-list-scroll-y = root.height - 98px - (root.selected-platform-index + 1) * 52px;
        }
    }

    function open-platform(index: int) {
        if (root.platforms.length <= 0) { return; }
        root.select-platform(index);
        root.selected-platform = root.platforms[root.selected-platform-index].slug;
        root.selected-platform-name = root.platforms[root.selected-platform-index].name;
        root.selected-game-index = 0;
        root.game-list-scroll-y = 0px;
        root.page = 1;
        root.loading = true;
        root.platform-query(root.selected-platform);
    }

    function select-game(index: int) {
        if (root.games.length <= 0) { return; }
        root.selected-game-index = min(max(index, 0), root.games.length - 1);
        root.details-loading = true;
        root.game-selected(root.games[root.selected-game-index].id, root.selected-game-index);

        if (root.selected-game-index * 42px < -root.game-list-scroll-y) {
            root.game-list-scroll-y = -root.selected-game-index * 42px;
        } else if ((root.selected-game-index + 1) * 42px > -root.game-list-scroll-y + root.height - 98px) {
            root.game-list-scroll-y = root.height - 98px - (root.selected-game-index + 1) * 42px;
        }
    }

    page-focus := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if (event.text == "\u{1b}") {
                if (root.artifact-sheet-open) {
                    root.artifact-sheet-open = false;
                    return accept;
                }
                if (root.page == 2) {
                    root.page = 1;
                    return accept;
                }
                if (root.page == 1) {
                    root.page = 0;
                    return accept;
                }
            }
            if (root.page == 0 && event.text == Key.UpArrow) {
                if (root.selected-platform-index == 0) {
                    root.focus-header();
                } else {
                    root.select-platform(root.selected-platform-index - 1);
                }
                return accept;
            }
            if (root.page == 0 && event.text == Key.DownArrow) {
                if (root.platforms.length > 0) {
                    root.select-platform(root.selected-platform-index + 1);
                }
                return accept;
            }
            if (root.page == 1 && event.text == Key.UpArrow) {
                if (root.selected-game-index == 0) {
                    root.focus-header();
                } else {
                    root.select-game(root.selected-game-index - 1);
                }
                return accept;
            }
            if (root.page == 1 && event.text == Key.DownArrow) {
                root.select-game(root.selected-game-index + 1);
                return accept;
            }
            if (event.text == "\n" || event.text == " ") {
                if (root.page == 0) {
                    root.open-platform(root.selected-platform-index);
                    return accept;
                }
                if (root.page == 1 && root.games.length > 0) {
                    root.select-game(root.selected-game-index);
                    root.page = 2;
                    return accept;
                }
            }
            return reject;
        }
    }

    if root.page == 0: VerticalLayout {
        spacing: Tokens.spacing-lg;
        HorizontalLayout {
            height: 38px;
            padding-left: Tokens.spacing-2xl;
            padding-right: Tokens.spacing-2xl;
            spacing: Tokens.spacing-sm;
            Typography { text: "Store"; variant: TextVariant.headline; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Input { width: 260px; text <=> root.search-query; placeholder: "Search platforms..."; }
        }
        Rectangle { height: 1px; background: Tokens.color-border-hairline; }
        if root.loading: HorizontalLayout {
            padding-left: Tokens.spacing-2xl;
            padding-right: Tokens.spacing-2xl;
            spacing: Tokens.spacing-md;
            vertical-stretch: 1;
            for _ in 5: Skeleton { width: (parent.width - 4 * Tokens.spacing-md) / 5; height: 158px; radius: Tokens.radius-lg; }
        }
        if !root.loading: ListView {
            viewport-y <=> root.platform-list-scroll-y;
            for platform[i] in root.platforms: Rectangle {
                width: parent.width;
                height: 52px;
                background: i == root.selected-platform-index && page-focus.has-focus
                    ? Tokens.color-surface-3
                    : (touch.has-hover ? Tokens.color-surface-2 : transparent);
                border-radius: Tokens.radius-sm;
                border-width: i == root.selected-platform-index && page-focus.has-focus ? Tokens.focus-ring-width : 0px;
                border-color: Tokens.color-ring-muted;
                HorizontalLayout {
                    padding-left: Tokens.spacing-2xl;
                    padding-right: Tokens.spacing-2xl;
                    spacing: Tokens.spacing-md;
                    Image {
                        width: 36px;
                        height: 36px;
                        source: platform.icon;
                        image-fit: contain;
                    }
                    Typography {
                        horizontal-stretch: 1;
                        text: platform.name;
                        variant: TextVariant.body-lg;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    VerticalLayout {
                        horizontal-stretch: 0;
                        alignment: center;
                        Badge {
                            text: platform.slug;
                            variant: BadgeVariant.outline;
                            size: BadgeSize.sm;
                        }
                    }
                    Typography {
                        width: 96px;
                        text: platform.game-count;
                        variant: TextVariant.caption;
                        tone: TextTone.muted;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
                touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        page-focus.focus();
                        root.open-platform(i);
                    }
                }
            }
        }
    }

    if root.page == 1: VerticalLayout {
        spacing: Tokens.spacing-lg;
        HorizontalLayout {
            height: 38px;
            padding-left: Tokens.spacing-2xl;
            padding-right: Tokens.spacing-2xl;
            spacing: Tokens.spacing-md;
            Button {
                width: 36px;
                height: 36px;
                variant: ButtonVariant.ghost;
                size: ButtonSize.icon;
                text: "";
                LucideIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    icon: IconSet.ArrowLeft;
                    size: 18px;
                }
                clicked => { root.page = 0; }
            }
            Typography { text: root.selected-platform-name; variant: TextVariant.headline; vertical-alignment: center; }
        }
        Rectangle { height: 1px; background: Tokens.color-border-hairline; }
        if root.loading: Skeleton { vertical-stretch: 1; radius: Tokens.radius-md; }
        if !root.loading: PlatformGameList {
            games: root.games;
            details: root.details;
            preview-image: root.preview-image;
            selected-index <=> root.selected-game-index;
            scroll-y <=> root.game-list-scroll-y;
            details-loading <=> root.details-loading;
            keyboard-active: page-focus.has-focus;
            selected(id, index) => { root.game-selected(id, index); root.page = 2; }
            focus-header => { root.focus-header(); }
            vertical-stretch: 1;
        }

    }

    if root.page == 2: GameDetailsView {
        game: root.games[root.selected-game-index];
        details: root.details;
        loading: root.details-loading;
        action-label: "Download";
        back => { root.page = 1; }
        action-requested => { root.artifact-sheet-open = true; }
    }


    if root.install-status != "": Rectangle {
        background: #00000088;
        TouchArea { clicked => { root.install-status = ""; } }
        Rectangle {
            width: 420px;
            height: 150px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Tokens.color-surface-1;
            border-radius: Tokens.radius-md;
            VerticalLayout {
                padding: Tokens.spacing-lg;
                spacing: Tokens.spacing-md;
                Typography { text: "Install"; variant: TextVariant.headline; }
                Typography { text: root.install-status; variant: TextVariant.body-sm; wrap: word-wrap; }
                Rectangle {
                    height: 5px;
                    background: Tokens.color-accent;
                    width: (parent.width - 2 * Tokens.spacing-lg) * root.install-progress;
                    border-radius: 3px;
                }
            }
        }
    }

    if root.artifact-sheet-open && root.games.length > 0: Sheet {
        open <=> root.artifact-sheet-open;
        side: SheetSide.right;
        panel-extent: 440px;
        title: "Download artifacts";
        description: root.games[root.selected-game-index].title;
        dismiss-on-backdrop: root.install-status == "";
        VerticalLayout {
            vertical-stretch: 1;
            padding: Tokens.spacing-lg;
            spacing: Tokens.spacing-md;
            Card {
                vertical-stretch: 1;
                background: Tokens.color-background;
                card-padding: CardPadding.none;
                card-radius: CardRadius.md;
                clip: true;

                if root.artifacts.length == 0: Typography {
                    x: Tokens.spacing-md;
                    y: Tokens.spacing-md;
                    width: parent.width - 2 * Tokens.spacing-md;
                    text: "No downloadable artifacts available.";
                    tone: TextTone.muted;
                    wrap: word-wrap;
                }

                if root.artifacts.length > 0: ListView {
                    width: parent.width;
                    height: parent.height;
                    for artifact in root.artifacts: Rectangle {
                        width: parent.width;
                        height: artifact.is-directory ? 36px : 64px;

                        if artifact.is-directory: LucideIcon {
                            x: Tokens.spacing-md + artifact.depth * Tokens.spacing-lg;
                            y: (parent.height - self.height) / 2;
                            icon: IconSet.ChevronDown;
                            tint: Tokens.color-muted-foreground;
                            size: 14px;
                        }
                        if artifact.is-directory: Typography {
                            x: Tokens.spacing-md + artifact.depth * Tokens.spacing-lg + 20px;
                            width: parent.width - 2 * Tokens.spacing-md - artifact.depth * Tokens.spacing-lg - 20px;
                            height: parent.height;
                            text: artifact.path;
                            variant: TextVariant.body-sm;
                            tone: TextTone.muted;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        if !artifact.is-directory: Rectangle {
                            width: parent.width;
                            height: parent.height;
                            background: root.selected-artifacts[artifact.file-index] ? Tokens.color-surface-3 : Tokens.color-surface-1;
                            border-radius: Tokens.radius-sm;
                            HorizontalLayout {
                                padding-left: Tokens.spacing-md + artifact.depth * Tokens.spacing-lg;
                                padding-right: Tokens.spacing-md;
                                padding-top: Tokens.spacing-md;
                                padding-bottom: Tokens.spacing-md;
                                spacing: Tokens.spacing-md;
                                Checkbox {
                                    width: 16px;
                                    height: 20px;
                                    checked: root.selected-artifacts[artifact.file-index];
                                    toggled(value) => {
                                        root.selected-artifacts[artifact.file-index] = value;
                                        root.selected-artifact-index = artifact.file-index;
                                        root.artifact-selected(artifact.file-index);
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: Tokens.spacing-xs;
                                    Typography {
                                        height: 16px;
                                        text: artifact.path;
                                        variant: TextVariant.body-sm;
                                        font-family: "monospace";
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    Typography {
                                        height: 12px;
                                        text: artifact.size;
                                        variant: TextVariant.caption;
                                        tone: TextTone.muted;
                                        font-family: "monospace";
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            Button {
                text: "Download selected";
                clicked => {
                    if (root.artifacts.length > 0) {
                        root.install-requested(root.games[root.selected-game-index].id, root.selected-artifacts);
                        root.artifact-sheet-open = false;
                    }
                }
            }
        }
    }
}
