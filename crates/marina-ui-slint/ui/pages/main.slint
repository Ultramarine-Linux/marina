import { Tokens } from "../slintcn/theme/tokens.slint";

import { NavigationItem } from "../slintcn/components/navigation-menu.slint";
import { AppShell } from "../components/app-shell.slint";
import { GameCardData } from "../components/card.slint";
import { Shelf, ShelfSkeleton } from "../components/shelf.slint";
import { LibraryPage } from "library.slint";
import { PlatformCardData } from "../components/platform-card.slint";
import { PreviewDetailsData } from "../components/preview-details.slint";
import { GameDetailsView } from "../components/game-details-view.slint";
import { StorePage, StoreArtifact } from "store.slint";
import { Toaster } from "../slintcn/components/toast.slint";
export { ToastQueue, ToastItem, ToastVariant } from "../slintcn/components/toast.slint";

export component MainWindow inherits Window {
    in property <[GameCardData]> games;
    in property <[PlatformCardData]> platforms;
    in property <[GameCardData]> platform-games;
    in property <[PlatformCardData]> store-platforms;
    in property <[GameCardData]> store-games;
    in property <PreviewDetailsData> store-details;
    in property <[StoreArtifact]> store-artifacts;
    in-out property <[bool]> store-selected-artifacts;
    in-out property <int> store-page: 0;

    in-out property <int> store-selected-game-index: 0;
    in-out property <int> store-selected-artifact-index: 0;
    in-out property <bool> store-loading: false;
    in-out property <bool> store-details-loading: false;
    in-out property <string> store-install-status;
    in-out property <float> store-install-progress: 0;
    in-out property <string> profile-name: "User";
    in-out property <string> profile-username: "user";
    in-out property <string> profile-initials: "U";
    in-out property <image> profile-image;
    in-out property <GameCardData> selected-game;
    in-out property <bool> game-page-visible: false;
    in-out property <PreviewDetailsData> game-details;
    in-out property <bool> game-details-loading: false;
    in-out property <bool> library-loading: false;

    in property <length> shelf-height;
    in-out property <bool> loading: true;
    callback viewport-changed(length, length);
    callback cover-context-changed(int);
    callback platform-query(string);
    callback game-selected(string, int);
    callback game-opened(string);
    callback game-play-requested(string);
    callback store-search(string);
    callback store-platform-query(string);
    callback store-game-selected(string, int);
    callback store-artifact-selected(int);
    callback store-install-requested(string, [bool]);
    callback store-entered;
    callback home-entered;
    callback library-entered;

    in-out property <int> active-tab: 0;
    in-out property <string> search-query;
    property <[NavigationItem]> navigation-items: [
        { label: "Home" },
        { label: "Library" },
        { label: "Store" },
    ];

    width: 1280px;
    height: 720px;
    title: "Marina";


    changed active-tab => {
        if (root.active-tab == 0) {
            root.loading = true;
            root.home-entered();
        }
        if (root.active-tab == 1) { root.library-entered(); }
        if (root.active-tab == 2) { root.store-entered(); }
    }

    AppShell {
        navigation-items: root.navigation-items;
        profile-name: root.profile-name;
        profile-username: root.profile-username;
        profile-initials: root.profile-initials;
        profile-image: root.profile-image;
        active-tab <=> root.active-tab;
        search-query <=> root.search-query;
        navigate(index) => { root.active-tab = index; }

        if root.game-page-visible: GameDetailsView {
            game: root.selected-game;
            details: root.game-details;
            loading: root.game-details-loading;
            back => { root.game-page-visible = false; }
            action-requested => { root.game-play-requested(root.selected-game.id); }
        }

        if !root.game-page-visible && root.active-tab == 0 && root.loading: ShelfSkeleton {
            content-height: root.shelf-height;
        }

        if !root.game-page-visible && root.active-tab == 0 && !root.loading: shelf := Shelf {
            title: "Recently added";
            games: root.games;
            content-height: root.shelf-height;
            viewport-changed(x, width) => { root.viewport-changed(x, width); }
            game-opened(id) => { root.game-opened(id); }
        }

        if !root.game-page-visible && root.active-tab == 1: LibraryPage {
            platforms: root.platforms;
            games: root.platform-games;
            details: root.game-details;
            details-loading <=> root.game-details-loading;
            initial-loading: root.loading;
            loading <=> root.library-loading;
            platform-query(slug) => { root.platform-query(slug); }
            game-selected(id, index) => { root.game-selected(id, index); }
        }

        if !root.game-page-visible && root.active-tab == 2: StorePage {
            platforms: root.store-platforms;
            games: root.store-games;
            details: root.store-details;
            artifacts: root.store-artifacts;
            selected-artifacts <=> root.store-selected-artifacts;
            page <=> root.store-page;

            selected-game-index <=> root.store-selected-game-index;
            selected-artifact-index <=> root.store-selected-artifact-index;
            search-query <=> root.search-query;
            loading <=> root.store-loading;
            details-loading <=> root.store-details-loading;
            install-status <=> root.store-install-status;
            install-progress <=> root.store-install-progress;
            platform-query(slug) => { root.store-platform-query(slug); }
            game-selected(id, index) => { root.store-game-selected(id, index); }
            artifact-selected(index) => { root.store-artifact-selected(index); }
            install-requested(id, selected) => { root.store-install-requested(id, selected); }
            search-requested(query) => { root.store-search(query); }
        }
    }

    // Global overlay: remains above every routed screen, dialog, and sheet.
    Toaster {
        width: parent.width;
        height: parent.height;
    }
}
