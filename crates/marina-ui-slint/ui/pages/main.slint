import { NavigationItem } from "../slintcn/components/navigation-menu.slint";
import { AppShell } from "../components/app-shell.slint";
import { PageRouter } from "../components/page-router.slint";
import { Toaster } from "../slintcn/components/toast.slint";
import { ShellPage } from "route.slint";
import { ShellState } from "../components/app-shell.slint";
import { HomeState } from "../components/shelf.slint";
import { LibraryState } from "library.slint";
import { GameState } from "../components/game-details-view.slint";
import { StoreState } from "store.slint";

export { ToastQueue, ToastItem, ToastVariant } from "../slintcn/components/toast.slint";
export { ShellPage } from "route.slint";
export { ShellState } from "../components/app-shell.slint";
export { HomeState } from "../components/shelf.slint";
export { LibraryState } from "library.slint";
export { GameState } from "../components/game-details-view.slint";
export { StoreState } from "store.slint";

export component MainWindow inherits Window {
    callback focus-navigation;
    property <[NavigationItem]> navigation-items: [
        { label: "Home" },
        { label: "Library" },
        { label: "Store" },
    ];

    // At the handheld's 2x UI scale this opens at 1280x720 physical pixels.
    preferred-width: 640px;
    preferred-height: 360px;
    min-width: 400px;
    min-height: 225px;
    title: "Marina";
    background: transparent;

    shell := AppShell {
        width: parent.width;
        height: parent.height;
        navigation-items: root.navigation-items;
        profile-name: ShellState.profile-name;
        profile-username: ShellState.profile-username;
        profile-initials: ShellState.profile-initials;
        profile-image: ShellState.profile-image;
        active-tab <=> ShellState.active-tab;
        search-query <=> ShellState.search-query;
        navigate(index) => { ShellState.navigate(index); }
        focus-content => { ShellState.content-focus-request += 1; }

        PageRouter { }
    }

    focus-navigation => { shell.focus(); }

    Toaster {
        width: parent.width;
        height: parent.height;
    }
}
