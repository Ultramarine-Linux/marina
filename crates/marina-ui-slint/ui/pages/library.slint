import { ListView } from "std-widgets.slint";
import { Tokens } from "../slintcn/theme/tokens.slint";

import { Skeleton } from "../slintcn/components/skeleton.slint";
import { Empty } from "../slintcn/components/empty.slint";
import { Text as Typography } from "../slintcn/components/text.slint";
import { TextVariant, TextTone } from "../slintcn/components/text.slint";
import { PlatformCardData } from "../components/platform-card.slint";
import { GameCardData } from "../components/card.slint";
import { PlatformGameList } from "../components/platform-game-list.slint";
import { PreviewDetailsData } from "../components/preview-details.slint";
import { PageHeader } from "../components/page-header.slint";
import { ShellState } from "../components/app-shell.slint";

export global LibraryState {
    in-out property <[PlatformCardData]> platforms;
    in-out property <[GameCardData]> games;
    in-out property <bool> loading: false;
    in-out property <int> selected-platform-index: 0;
    in-out property <int> selected-game-index: 0;
    in-out property <length> game-list-scroll-y: 0px;
    // Sub-page state lives here (not in LibraryPage) so drilling into a
    // platform survives the page component being destroyed on route changes.
    in-out property <int> page: 0;
    in-out property <string> selected-platform;
    in-out property <string> selected-platform-name;
    callback entered;
    callback platform-query(string);
    callback game-selected(string, int);
    callback game-opened(string, int);
}

export component LibraryPage inherits Rectangle {
    in property <[PlatformCardData]> platforms;
    in property <[GameCardData]> games;
    in property <PreviewDetailsData> details;
    in-out property <int> page: 0;

    in-out property <string> selected-platform;
    in-out property <string> selected-platform-name;
    in-out property <int> selected-platform-index: 0;
    in-out property <int> selected-game-index: 0;
    in property <int> focus-request: 0;
    private property <length> platform-list-scroll-y: 0px;
    private property <int> header-focus-request: 0;
    in-out property <length> game-list-scroll-y: 0px;

    in property <bool> initial-loading: false;
    in-out property <bool> loading: false;
    in-out property <bool> details-loading: false;

    callback platform-query(string);
    callback game-selected(string, int);
    callback game-opened(string, int);
    callback focus-header;

    background: transparent;
    forward-focus: page-focus;
    changed focus-request => { page-focus.focus(); }

    function select-platform(index: int) {
        if (root.platforms.length <= 0) { return; }
        root.selected-platform-index = min(max(index, 0), root.platforms.length - 1);

        if (root.selected-platform-index * 52px < -root.platform-list-scroll-y) {
            root.platform-list-scroll-y = -root.selected-platform-index * 52px;
        } else if ((root.selected-platform-index + 1) * 52px > -root.platform-list-scroll-y + root.height - 98px) {
            root.platform-list-scroll-y = root.height - 98px - (root.selected-platform-index + 1) * 52px;
        }
    }

    function open-platform(index: int) {
        if (root.platforms.length <= 0) { return; }
        root.select-platform(index);
        root.selected-platform = root.platforms[root.selected-platform-index].slug;
        root.selected-platform-name = root.platforms[root.selected-platform-index].name;
        root.selected-game-index = 0;
        root.game-list-scroll-y = 0px;
        root.page = 1;
        root.loading = true;
        root.details-loading = true;
        root.platform-query(root.selected-platform);
    }

    function select-game(index: int) {
        if (root.games.length <= 0) { return; }
        root.selected-game-index = min(max(index, 0), root.games.length - 1);
        root.details-loading = true;
        root.game-selected(root.games[root.selected-game-index].id, root.selected-game-index);

        if (root.selected-game-index * 42px < -root.game-list-scroll-y) {
            root.game-list-scroll-y = -root.selected-game-index * 42px;
        } else if ((root.selected-game-index + 1) * 42px > -root.game-list-scroll-y + root.height - 98px) {
            root.game-list-scroll-y = root.height - 98px - (root.selected-game-index + 1) * 42px;
        }
    }

    function activate-selected-game() {
        if (root.games.length <= 0) { return; }
        root.select-game(root.selected-game-index);
        root.game-opened(root.games[root.selected-game-index].id, root.selected-game-index);
    }

    page-focus := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if (event.text == "\u{1b}" && root.page == 1) {
                ShellState.back-requested();
                return accept;
            }

            if (event.text == Key.UpArrow) {
                if (root.page == 0 && root.selected-platform-index == 0) {
                    root.focus-header();
                } else if (root.page == 0) {
                    root.select-platform(root.selected-platform-index - 1);
                } else {
                    root.select-game(root.selected-game-index - 1);
                }
                return accept;
            }
            if (event.text == Key.DownArrow) {
                if (root.page == 0 && root.platforms.length > 0) {
                    root.select-platform(root.selected-platform-index + 1);
                } else if (root.page == 1) {
                    root.select-game(root.selected-game-index + 1);
                }
                return accept;
            }
            if (event.text == "\n" || event.text == " ") {
                if (root.page == 0) {
                    root.open-platform(root.selected-platform-index);
                } else {
                    root.activate-selected-game();
                }
                return accept;
            }
            return reject;
        }
    }

    if root.page == 0: VerticalLayout {
        spacing: Tokens.spacing-lg;


        if root.initial-loading: HorizontalLayout {
            padding-left: Tokens.spacing-2xl;
            padding-right: Tokens.spacing-2xl;
            spacing: Tokens.spacing-md;
            vertical-stretch: 1;
            for _ in 5: Skeleton {
                width: (parent.width - 4 * Tokens.spacing-md) / 5;
                height: 158px;
                radius: Tokens.radius-lg;
            }
        }

        if !root.initial-loading && root.platforms.length == 0: Empty {
            width: parent.width;
            vertical-stretch: 1;
            title: "No platforms found";
            description: "Your library does not contain any platforms yet.";
            action-label: "";
        }
        if !root.initial-loading && root.platforms.length > 0: ListView {
            width: parent.width;
            vertical-stretch: 1;
            viewport-y <=> root.platform-list-scroll-y;
            for platform[i] in root.platforms: Rectangle {
                width: parent.width;
                height: 52px;
                background: i == root.selected-platform-index && page-focus.has-focus
                    ? Tokens.color-surface-3
                    : (platform-touch.has-hover ? Tokens.color-surface-2 : transparent);
                border-radius: Tokens.radius-sm;
                border-width: i == root.selected-platform-index && page-focus.has-focus ? Tokens.focus-ring-width : 0px;
                border-color: Tokens.color-ring-muted;


                Image {
                    x: Tokens.spacing-2xl;
                    y: 8px;
                    width: 36px;
                    height: 36px;
                    source: platform.icon;
                    image-fit: contain;
                }
                // Text {
                //     x: Tokens.spacing-sm;
                //     y: 8px;
                //     width: 36px;
                //     height: 36px;
                //     text: platform.icon;
                //     font-size: 22px;
                //     horizontal-alignment: center;
                //     vertical-alignment: center;
                // }

                Typography {
                    x: Tokens.spacing-2xl + 48px;
                    y: 0px;
                    width: parent.width - 2 * Tokens.spacing-2xl - 48px - 88px;
                    height: parent.height;
                    text: platform.name;
                    variant: TextVariant.body-lg;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Typography {
                    x: parent.width - Tokens.spacing-2xl - 72px;
                    y: 0px;
                    width: 72px;
                    height: parent.height;
                    text: platform.game-count;
                    variant: TextVariant.caption;
                    tone: TextTone.muted;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }

                platform-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        page-focus.focus();
                        root.open-platform(i);
                    }
                }
            }
        }
    }

    if root.page == 1: VerticalLayout {
        spacing: Tokens.spacing-lg;

        PageHeader {
            title: root.selected-platform-name;
            focus-request: root.header-focus-request;
            crumbs: ShellState.breadcrumbs;
            back => { ShellState.back-requested(); }
            crumb-navigate(index) => { ShellState.crumb-navigate(index); }
        }

        if root.loading: Rectangle {
            vertical-stretch: 1;
            HorizontalLayout {
                spacing: Tokens.spacing-lg;
                Skeleton {
                    width: 34%;
                    height: 400px;
                    radius: Tokens.radius-md;
                }
                Skeleton {
                    horizontal-stretch: 1;
                    height: 400px;
                    radius: Tokens.radius-md;
                }
            }
        }

        if !root.loading && root.games.length == 0: Empty {
            width: parent.width;
            vertical-stretch: 1;
            title: "No games found";
            description: "This platform does not contain any games yet.";
            action-label: "";
        }
        if !root.loading && root.games.length > 0: PlatformGameList {
            games: root.games;
            details: root.details;
            details-loading <=> root.details-loading;
            selected-index <=> root.selected-game-index;
            scroll-y <=> root.game-list-scroll-y;
            keyboard-active: page-focus.has-focus;
            selected(id, index) => { root.game-selected(id, index); }
            activate-requested => { root.activate-selected-game(); }
            focus-header => { root.header-focus-request += 1; }
            vertical-stretch: 1;
        }


    }
}
