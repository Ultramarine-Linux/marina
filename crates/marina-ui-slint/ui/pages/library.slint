import { ListView } from "std-widgets.slint";
import { Tokens } from "../slintcn/theme/tokens.slint";
import { Button, ButtonVariant, ButtonSize } from "../slintcn/components/button.slint";
import { Input } from "../slintcn/components/input.slint";
import { Skeleton } from "../slintcn/components/skeleton.slint";
import { Text as Typography } from "../slintcn/components/text.slint";
import { TextVariant, TextTone } from "../slintcn/components/text.slint";
import { PlatformCardData } from "../components/platform-card.slint";
import { GameCardData } from "../components/card.slint";
import { PlatformGameList } from "../components/platform-game-list.slint";
import { PreviewDetailsData } from "../components/preview-details.slint";
import { LucideIcon } from "../slintcn/components/lucide-icon.slint";
import { IconSet } from "@lucide/lucide.slint";

export component LibraryPage inherits Rectangle {
    in property <[PlatformCardData]> platforms;
    in property <[GameCardData]> games;
    in property <PreviewDetailsData> details;
    in-out property <int> page: 0;
    in-out property <string> search-query;
    in-out property <string> selected-platform;
    in-out property <string> selected-platform-name;
    in-out property <length> game-list-scroll-y: 0px;

    in property <bool> initial-loading: false;
    in-out property <bool> loading: false;
    in-out property <bool> details-loading: false;

    callback platform-query(string);
    callback game-selected(string, int);

    background: transparent;

    if root.page == 0: VerticalLayout {
        spacing: Tokens.spacing-lg;

        HorizontalLayout {
            height: 38px;
            padding-left: Tokens.spacing-2xl;
            padding-right: Tokens.spacing-2xl;
            spacing: Tokens.spacing-sm;

            Typography {
                text: "Platforms";
                variant: TextVariant.headline;
                vertical-alignment: center;
            }

            Rectangle {
                width: 36px;
                height: 24px;
                y: (parent.height - self.height) / 2;
                background: Tokens.color-surface-2;
                border-radius: Tokens.radius-sm;

                Typography {
                    text: root.platforms.length;
                    variant: TextVariant.caption;
                    tone: TextTone.muted;
                    width: parent.width;
                    height: parent.height;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Rectangle { horizontal-stretch: 1; }

            Input {
                width: 260px;
                text <=> root.search-query;
                placeholder: "Search platforms...";
            }
        }

        Rectangle {
            height: 1px;
            background: Tokens.color-border-hairline;
        }

        if root.initial-loading: HorizontalLayout {
            padding-left: Tokens.spacing-2xl;
            padding-right: Tokens.spacing-2xl;
            spacing: Tokens.spacing-md;
            vertical-stretch: 1;
            for _ in 5: Skeleton {
                width: (parent.width - 4 * Tokens.spacing-md) / 5;
                height: 158px;
                radius: Tokens.radius-lg;
            }
        }

        if !root.initial-loading: ListView {
            width: parent.width;
            vertical-stretch: 1;
            for platform[i] in root.platforms: Rectangle {
                width: parent.width;
                height: 52px;
                background: platform-touch.has-hover
                    ? Tokens.color-surface-2
                    : transparent;
                border-radius: Tokens.radius-sm;


                Image {
                    x: Tokens.spacing-2xl;
                    y: 8px;
                    width: 36px;
                    height: 36px;
                    source: platform.icon;
                    image-fit: contain;
                }
                // Text {
                //     x: Tokens.spacing-sm;
                //     y: 8px;
                //     width: 36px;
                //     height: 36px;
                //     text: platform.icon;
                //     font-size: 22px;
                //     horizontal-alignment: center;
                //     vertical-alignment: center;
                // }

                Typography {
                    x: Tokens.spacing-2xl + 48px;
                    y: 0px;
                    width: parent.width - 2 * Tokens.spacing-2xl - 48px - 88px;
                    height: parent.height;
                    text: platform.name;
                    variant: TextVariant.body-lg;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Typography {
                    x: parent.width - Tokens.spacing-2xl - 72px;
                    y: 0px;
                    width: 72px;
                    height: parent.height;
                    text: platform.game-count;
                    variant: TextVariant.caption;
                    tone: TextTone.muted;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }

                platform-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.selected-platform = platform.slug;
                        root.selected-platform-name = platform.name;
                        root.game-list-scroll-y = 0px;
                        root.page = 1;
                        root.loading = true;
                        root.details-loading = true;
                        root.platform-query(platform.slug);
                    }
                }
            }
        }
    }

    if root.page == 1: VerticalLayout {
        spacing: Tokens.spacing-lg;

        HorizontalLayout {
            height: 38px;
            padding-left: Tokens.spacing-2xl;
            padding-right: Tokens.spacing-2xl;
            spacing: Tokens.spacing-md;

            Button {
                width: 36px;
                height: 36px;
                variant: ButtonVariant.ghost;
                size: ButtonSize.icon;
                text: "";
                LucideIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    icon: IconSet.ArrowLeft;
                    size: 18px;
                }
                clicked => {
                    root.page = 0;

                }
            }

            Typography {
                text: root.selected-platform-name;
                variant: TextVariant.headline;
                vertical-alignment: center;
            }
        }

        Rectangle {
            height: 1px;
            background: Tokens.color-border-hairline;
        }

        if root.loading: Rectangle {
            vertical-stretch: 1;
            HorizontalLayout {
                spacing: Tokens.spacing-lg;
                Skeleton {
                    width: 34%;
                    height: 400px;
                    radius: Tokens.radius-md;
                }
                Skeleton {
                    horizontal-stretch: 1;
                    height: 400px;
                    radius: Tokens.radius-md;
                }
            }
        }

        if !root.loading: PlatformGameList {
            games: root.games;
            details: root.details;
            details-loading <=> root.details-loading;
            scroll-y <=> root.game-list-scroll-y;
            selected(id, index) => { root.game-selected(id, index); }
            vertical-stretch: 1;
        }


    }
}
