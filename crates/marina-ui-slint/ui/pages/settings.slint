import { ListView } from "std-widgets.slint";
import { Tokens } from "../slintcn/theme/tokens.slint";

import { Text as Typography } from "../slintcn/components/text.slint";
import { TextVariant, TextTone } from "../slintcn/components/text.slint";
import { CrumbHeader } from "../components/crumb-header.slint";
import { ShellState } from "../components/app-shell.slint";

export struct SettingsEntry {
    title: string,
    summary: string,
}

export component SettingsPage inherits Rectangle {
    in property <int> focus-request: 0;
    callback focus-header;

    property <[SettingsEntry]> entries: [
        {
            title: "Placeholder",
            summary: "placeholder.",
        },
    ];
    property <int> selected-index: 0;

    background: transparent;
    forward-focus: page-focus;

    changed focus-request => {
        focus-defer-timer.stop();
        focus-defer-timer.start();
    }

    focus-defer-timer := Timer {
        interval: 50ms;
        triggered => {
            self.stop();
            page-focus.focus();
        }
    }

    function select-entry(index: int) {
        if (root.entries.length <= 0) { return; }
        root.selected-index = min(max(index, 0), root.entries.length - 1);
    }

    page-focus := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if (event.text == "\u{1b}") {
                ShellState.back-requested();
                return accept;
            }
            if (event.text == Key.UpArrow) {
                if (root.selected-index == 0) {
                    root.focus-header();
                } else {
                    root.select-entry(root.selected-index - 1);
                }
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.select-entry(root.selected-index + 1);
                return accept;
            }
            return reject;
        }
    }

    VerticalLayout {
        spacing: Tokens.spacing-lg;

        CrumbHeader {
            crumbs: ShellState.breadcrumbs;
            crumb-navigate(index) => { ShellState.crumb-navigate(index); }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: Tokens.spacing-lg;

            Rectangle {
                width: 34%;
                min-width: 260px;
                background: Tokens.color-surface-1;
                border-radius: Tokens.radius-md;
                clip: true;

                ListView {
                    width: parent.width;
                    height: parent.height;
                    for entry[i] in root.entries: Rectangle {
                        width: parent.width;
                        height: 42px;
                        background: i == root.selected-index
                            ? Tokens.color-surface-3
                            : (entry-touch.has-hover ? Tokens.color-surface-2 : transparent);
                        border-radius: Tokens.radius-sm;
                        border-width: page-focus.has-focus && i == root.selected-index ? Tokens.focus-ring-width : 0px;
                        border-color: Tokens.color-ring-muted;

                        Typography {
                            x: Tokens.spacing-2xl;
                            width: parent.width - 2 * Tokens.spacing-2xl;
                            height: parent.height;
                            text: entry.title;
                            variant: TextVariant.body-lg;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        entry-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                page-focus.focus();
                                root.select-entry(i);
                            }
                        }
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                background: Tokens.color-surface-1;
                border-radius: Tokens.radius-md;

                VerticalLayout {
                    padding: Tokens.spacing-xl;
                    spacing: Tokens.spacing-lg;

                    Typography {
                        text: root.entries[root.selected-index].title;
                        variant: TextVariant.title;
                        overflow: elide;
                    }

                    Typography {
                        text: root.entries[root.selected-index].summary;
                        variant: TextVariant.body-lg;
                        tone: TextTone.muted;
                        wrap: word-wrap;
                    }

                    Rectangle { vertical-stretch: 1; }
                }
            }
        }
    }
}
