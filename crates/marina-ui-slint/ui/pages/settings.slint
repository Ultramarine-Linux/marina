import { ListView } from "std-widgets.slint";
import { Tokens } from "../slintcn/theme/tokens.slint";

import { Text as Typography } from "../slintcn/components/text.slint";
import { TextVariant, TextTone } from "../slintcn/components/text.slint";
import { Input } from "../slintcn/components/input.slint";
import { Switch } from "../slintcn/components/switch.slint";
import { CrumbHeader } from "../components/crumb-header.slint";
import { WifiState } from "../components/wifi-state.slint";
import { LucideIcon } from "../slintcn/components/lucide-icon.slint";
import { IconSet } from "@lucide/lucide.slint";
import { ShellState } from "../components/app-shell.slint";
import { FocusListScroll } from "../components/focus-list-scroll.slint";

export struct SettingsEntry {
    path: string,
    title: string,
    summary: string,
    control: string,
    value: string,
    bool-value: bool,
    sensitive: bool,
    environment-overridden: bool,
}

export struct SettingsPanel {
    title: string,
    entries: [SettingsEntry],
}

export struct SettingsSection {
    title: string,
    panels: [SettingsPanel],
}

export struct SettingsPanelItem {
    section-index: int,
    panel-index: int,
    navigation-index: int,
}

export struct SettingsNavigationItem {
    title: string,
    is-section: bool,
    panel-selection-index: int,
    scroll-y: length,
    height: length,
}

export global SettingsState {
    in-out property <[SettingsSection]> sections;
    in-out property <[SettingsPanelItem]> panels;
    in-out property <[SettingsNavigationItem]> navigation;
    in-out property <length> navigation-content-height;
    in-out property <[string]> platform-names;
    callback setting-changed(string, string, string, bool);
}

export component SettingsPage inherits Rectangle {
    in property <int> focus-request: 0;
    callback focus-header;

    private property <[SettingsSection]> sections: SettingsState.sections;
    private property <[SettingsPanelItem]> panels: SettingsState.panels;
    private property <[SettingsNavigationItem]> navigation: SettingsState.navigation;
    private property <length> navigation-content-height: SettingsState.navigation-content-height;
    property <int> selected-section: 0;
    property <int> selected-panel: 0;
    private property <int> selected-panel-index: 0;
    private property <int> selected-navigation-index: 1;
    private property <int> active-pane: 0;
    private property <int> selected-entry: 0;
    private property <int> selected-platform: 0;
    private property <int> selected-network: 0;
    private property <length> panel-list-scroll-y: 0px;
    private property <length> entry-list-scroll-y: 0px;
    private property <length> platform-list-scroll-y: 0px;
    private property <length> network-list-scroll-y: 0px;
    private property <[string]> menu-stack: [];
    private property <string> menu-open-target: "";
    private property <[string]> platform-names: SettingsState.platform-names;
    private property <string> detail-ssid: "";
    private property <bool> detail-active: false;

    private property <SettingsSection> current-section: root.sections[root.selected-section];
    private property <SettingsPanel> current-panel: root.current-section.panels[root.selected-panel];
    private property <bool> menu-open: root.menu-stack.length > 0;
    private property <bool> detail-open: root.menu-stack.length > 1;
    private property <bool> platform-menu: root.menu-open-target == "runtime.retroarch.platforms";
    private property <bool> wifi-menu: root.menu-open-target == "network.wifi";

    background: transparent;
    forward-focus: page-focus;

    changed focus-request => {
        focus-defer-timer.stop();
        focus-defer-timer.start();
    }

    focus-defer-timer := Timer {
        interval: 50ms;
        triggered => {
            self.stop();
            page-focus.focus();
        }
    }

    function select-panel(index: int) {
        if (root.panels.length <= 0) { return; }
        root.selected-panel-index = min(max(index, 0), root.panels.length - 1);
        let selected = root.panels[root.selected-panel-index];
        root.selected-section = selected.section-index;
        root.selected-panel = selected.panel-index;
        root.selected-navigation-index = selected.navigation-index;
        root.selected-entry = 0;
        root.entry-list-scroll-y = 0px;
    }

    function open-menu(target: string) {
        if (target != "runtime.retroarch.platforms" && target != "network.wifi") { return; }
        root.menu-open-target = target;
        root.menu-stack = [target];
        root.selected-platform = 0;
        root.platform-list-scroll-y = 0px;
        root.selected-network = 0;
        root.network-list-scroll-y = 0px;
        root.active-pane = 1;
        if (target == "network.wifi") {
            WifiState.refresh();
        }
    }

    function activate-entry(index: int) {
        if (index < 0 || index >= root.current-panel.entries.length) { return; }
        let entry = root.current-panel.entries[index];
        if (entry.control == "menu") {
            root.open-menu(entry.path);
        } else if (entry.control == "toggle" && !entry.environment-overridden) {
            SettingsState.setting-changed(entry.path, entry.control, "", !entry.bool-value);
        }
    }

    function activate-selected-entry() {
        root.activate-entry(root.selected-entry);
    }

    function open-platform(index: int) {
        if (root.platform-names.length <= 0) { return; }
        root.selected-platform = min(max(index, 0), root.platform-names.length - 1);
        root.menu-stack = [root.menu-open-target, root.platform-names[root.selected-platform]];
    }

    function close-menu() {
        if (!root.menu-open) { return; }
        if (root.detail-open) {
            root.menu-stack = [root.menu-open-target];
        } else {
            root.menu-stack = [];
            root.menu-open-target = "";
            root.active-pane = 0;
        }
    }

    function activate-network(index: int) {
        if (!WifiState.available) { return; }
        if (index == 0) {
            WifiState.set-enabled(!WifiState.enabled);
            return;
        }
        if (!WifiState.enabled || index - 1 >= WifiState.networks.length) { return; }
        let network = WifiState.networks[index - 1];
        if (network.active) {
            root.detail-ssid = network.ssid;
            root.detail-active = true;
            root.menu-stack = [root.menu-open-target, network.ssid];
        } else if (network.secured && !network.saved) {
            root.detail-ssid = network.ssid;
            root.detail-active = false;
            root.menu-stack = [root.menu-open-target, network.ssid];
        } else {
            WifiState.connect(network.ssid, "");
        }
    }

    function move-entry(delta: int) {
        if (root.current-panel.entries.length <= 0) { return; }
        root.selected-entry = min(max(root.selected-entry + delta, 0), root.current-panel.entries.length - 1);
    }

    function move-platform(delta: int) {
        if (root.platform-names.length <= 0) { return; }
        root.selected-platform = min(max(root.selected-platform + delta, 0), root.platform-names.length - 1);
    }

    function move-network(delta: int) {
        root.selected-network = min(max(root.selected-network + delta, 0), WifiState.networks.length);
    }

    function move-panel(delta: int) {
        root.select-panel(root.selected-panel-index + delta);
    }

    page-focus := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if (event.text == "\u{1b}") {
                if (root.menu-open) {
                    root.close-menu();
                } else {
                    ShellState.back-requested();
                }
                return accept;
            }
            if (root.menu-open) {
                if (event.text == Key.UpArrow) {
                    if (!root.detail-open) {
                        if (root.wifi-menu) { root.move-network(-1); } else { root.move-platform(-1); }
                    }
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    if (!root.detail-open) {
                        if (root.wifi-menu) { root.move-network(1); } else { root.move-platform(1); }
                    }
                    return accept;
                }
                if (event.text == Key.Return) {
                    if (root.detail-open) {
                        if (root.wifi-menu && root.detail-active) {
                            WifiState.disconnect();
                            root.close-menu();
                        }
                        return accept;
                    }
                    if (root.wifi-menu) {
                        root.activate-network(root.selected-network);
                    } else {
                        root.open-platform(root.selected-platform);
                    }
                    return accept;
                }
                return reject;
            }
            if (event.text == Key.UpArrow) {
                if (root.active-pane == 1) {
                    root.move-entry(-1);
                } else if (root.selected-panel-index == 0) {
                    root.focus-header();
                } else {
                    root.move-panel(-1);
                }
                return accept;
            }
            if (event.text == Key.DownArrow) {
                if (root.active-pane == 1) {
                    root.move-entry(1);
                } else {
                    root.move-panel(1);
                }
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.active-pane = 1;
                return accept;
            }
            if (event.text == Key.LeftArrow) {
                root.active-pane = 0;
                return accept;
            }
            if (event.text == Key.Return && root.active-pane == 1) {
                root.activate-selected-entry();
                return accept;
            }
            return reject;
        }
    }

    VerticalLayout {
        spacing: Tokens.spacing-lg;

        CrumbHeader {
            crumbs: ShellState.breadcrumbs;
            crumb-navigate(index) => { ShellState.crumb-navigate(index); }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: Tokens.spacing-lg;

            Rectangle {
                width: 34%;
                min-width: 240px;
                background: Tokens.color-surface-1;
                border-radius: Tokens.radius-md;
                clip: true;

                panel-list-scroll := FocusListScroll {
                    use-explicit-focus: true;
                    focus-y: root.navigation[root.selected-navigation-index].scroll-y;
                    focus-height: root.navigation[root.selected-navigation-index].height;
                    content-height: root.navigation-content-height;
                    viewport-height: panel-list.height;
                    viewport-y <=> root.panel-list-scroll-y;
                }

                panel-list := ListView {
                    width: parent.width;
                    height: parent.height;
                    viewport-y <=> root.panel-list-scroll-y;
                    for item[index] in root.navigation: Rectangle {
                        width: parent.width;
                        height: item.height;
                        background: !item.is-section && index == root.selected-navigation-index
                            ? Tokens.color-surface-3
                            : (panel-touch.has-hover && !item.is-section ? Tokens.color-surface-2 : transparent);
                        border-radius: Tokens.radius-sm;
                        border-width: !item.is-section && page-focus.has-focus && index == root.selected-navigation-index
                            ? Tokens.focus-ring-width : 0px;
                        border-color: Tokens.color-ring-muted;

                        if item.is-section: Typography {
                            x: Tokens.spacing-2xl;
                            width: parent.width - 2 * Tokens.spacing-2xl;
                            height: parent.height;
                            text: item.title;
                            variant: TextVariant.caption;
                            tone: TextTone.muted;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        if !item.is-section: Typography {
                            x: Tokens.spacing-2xl;
                            width: parent.width - 2 * Tokens.spacing-2xl;
                            height: parent.height;
                            text: item.title;
                            variant: TextVariant.body-lg;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        panel-touch := TouchArea {
                            enabled: !item.is-section;
                            mouse-cursor: item.is-section ? default : pointer;
                            clicked => {
                                page-focus.focus();
                                root.select-panel(item.panel-selection-index);
                            }
                        }
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                background: Tokens.color-surface-1;
                border-radius: Tokens.radius-md;
                clip: true;

                if !root.menu-open: VerticalLayout {
                    padding: Tokens.spacing-xl;
                    spacing: Tokens.spacing-md;

                    entry-list-scroll := FocusListScroll {
                        selected-index: root.selected-entry;
                        item-count: root.current-panel.entries.length;
                        item-height: 124px;
                        viewport-height: entry-list.height;
                        viewport-y <=> root.entry-list-scroll-y;
                    }

                    entry-list := ListView {
                        vertical-stretch: 1;
                        viewport-y <=> root.entry-list-scroll-y;
                        for entry[entry-index] in root.current-panel.entries: Rectangle {
                            width: parent.width;
                            height: 124px;
                            background: entry-index == root.selected-entry && root.active-pane == 1
                                ? Tokens.color-surface-3
                                : Tokens.color-surface-2;
                            border-radius: 0px;
                            border-width: entry-index == root.selected-entry && root.active-pane == 1 && page-focus.has-focus
                                ? Tokens.focus-ring-width : 0px;
                            border-color: Tokens.color-ring-muted;

                            VerticalLayout {
                                padding: Tokens.spacing-md;
                                spacing: Tokens.spacing-xs;
                                Typography {
                                    text: entry.title;
                                    variant: TextVariant.body-lg;
                                    overflow: elide;
                                }
                                Typography {
                                    text: entry.summary;
                                    variant: TextVariant.caption;
                                    tone: TextTone.muted;
                                    wrap: word-wrap;
                                    max-height: 36px;
                                }
                                Typography {
                                    text: entry.environment-overridden
                                        ? "Overridden by environment; read-only"
                                        : entry.path;
                                    variant: TextVariant.caption;
                                    tone: TextTone.muted;
                                    overflow: elide;
                                }

                                if entry.control == "text" || entry.control == "secret" || entry.control == "path": Input {
                                    text: entry.value;
                                    placeholder: entry.control == "path" ? "Enter a path" : "Not configured";
                                    password: entry.sensitive || entry.control == "secret";
                                    read-only: entry.environment-overridden;
                                    compact: true;
                                    accepted(value) => {
                                        if (!entry.environment-overridden) {
                                            SettingsState.setting-changed(entry.path, entry.control, value, false);
                                        }
                                    }
                                }

                                if entry.control == "menu": Typography {
                                    text: ">";
                                    variant: TextVariant.title;
                                    tone: TextTone.muted;
                                    horizontal-alignment: right;
                                }

                                if entry.control == "list" || entry.control == "map": Typography {
                                    text: "List editing is not available yet.";
                                    variant: TextVariant.body;
                                    tone: TextTone.muted;
                                    wrap: word-wrap;
                                }
                            }

                            if entry.control == "toggle": Switch {
                                x: parent.width - self.preferred-width - Tokens.spacing-lg;
                                y: (parent.height - self.preferred-height) / 2;
                                label: "";
                                checked: entry.bool-value;
                                disabled: entry.environment-overridden;
                                toggled(value) => {
                                    SettingsState.setting-changed(entry.path, entry.control, "", value);
                                }
                            }

                            // The generated row's layout sits beneath the visual
                            // switch on some backends. Make the complete row a
                            // semantic activation target, matching controller confirm.
                            if entry.control == "toggle" && !entry.environment-overridden: TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    page-focus.focus();
                                    root.selected-entry = entry-index;
                                    root.active-pane = 1;
                                    root.activate-entry(entry-index);
                                }
                            }

                            if entry.control == "menu": TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    page-focus.focus();
                                    root.selected-entry = entry-index;
                                    root.active-pane = 1;
                                    root.open-menu(entry.path);
                                }
                            }
                        }
                    }
                }

                if root.menu-open && !root.detail-open && root.platform-menu: VerticalLayout {
                    padding: Tokens.spacing-xl;
                    spacing: Tokens.spacing-md;

                    Typography {
                        text: "Platforms";
                        variant: TextVariant.title;
                    }
                    Typography {
                        text: "Choose a platform to configure in RetroArch.";
                        variant: TextVariant.caption;
                        tone: TextTone.muted;
                    }
                    platform-list-scroll := FocusListScroll {
                        selected-index: root.selected-platform;
                        item-count: root.platform-names.length;
                        item-height: 58px;
                        viewport-height: platform-list.height;
                        viewport-y <=> root.platform-list-scroll-y;
                    }

                    platform-list := ListView {
                        vertical-stretch: 1;
                        viewport-y <=> root.platform-list-scroll-y;
                        for platform[index] in root.platform-names: Rectangle {
                            width: parent.width;
                            height: 58px;
                            background: index == root.selected-platform ? Tokens.color-surface-3 : Tokens.color-surface-2;
                            border-radius: Tokens.radius-sm;
                            border-width: index == root.selected-platform && page-focus.has-focus
                                ? Tokens.focus-ring-width : 0px;
                            border-color: Tokens.color-ring-muted;

                            Typography {
                                x: Tokens.spacing-lg;
                                width: parent.width - 2 * Tokens.spacing-lg;
                                height: parent.height;
                                text: platform;
                                variant: TextVariant.body-lg;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    page-focus.focus();
                                    root.open-platform(index);
                                }
                            }
                        }
                    }
                    if root.platform-names.length == 0: Typography {
                        text: "No platform overrides are configured.";
                        variant: TextVariant.body;
                        tone: TextTone.muted;
                    }
                }

                if root.detail-open && root.platform-menu: VerticalLayout {
                    padding: Tokens.spacing-xl;
                    spacing: Tokens.spacing-md;

                    Typography {
                        text: root.menu-stack[1];
                        variant: TextVariant.title;
                        overflow: elide;
                    }
                    Typography {
                        text: "Platform-specific RetroArch settings will be editable here.";
                        variant: TextVariant.body;
                        tone: TextTone.muted;
                        wrap: word-wrap;
                    }
                    Typography {
                        text: "Press Back to return to Platforms.";
                        variant: TextVariant.caption;
                        tone: TextTone.muted;
                    }
                }

                if root.menu-open && !root.detail-open && root.wifi-menu: VerticalLayout {
                    padding: Tokens.spacing-xl;
                    spacing: Tokens.spacing-md;

                    Typography {
                        text: "Wi-Fi";
                        variant: TextVariant.title;
                    }
                    Typography {
                        text: "Turn Wi-Fi on or off and choose a network.";
                        variant: TextVariant.caption;
                        tone: TextTone.muted;
                    }

                    if !WifiState.available: Typography {
                        text: "NetworkManager is not available.";
                        variant: TextVariant.body;
                        tone: TextTone.muted;
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        visible: WifiState.available;
                        clip: true;

                        network-list-scroll := FocusListScroll {
                            selected-index: root.selected-network;
                            item-count: WifiState.networks.length + 1;
                            item-height: 58px;
                            viewport-height: network-flick.height;
                            viewport-y <=> root.network-list-scroll-y;
                        }

                        network-flick := Flickable {
                            width: parent.width;
                            height: parent.height;
                            viewport-height: network-content.preferred-height;
                            viewport-y <=> root.network-list-scroll-y;

                            network-content := VerticalLayout {
                                width: network-flick.width;
                            // Row 0: the radio toggle.
                            Rectangle {
                                width: parent.width;
                                height: 58px;
                                background: root.selected-network == 0 ? Tokens.color-surface-3 : Tokens.color-surface-2;
                                border-radius: Tokens.radius-sm;
                                border-width: root.selected-network == 0 && page-focus.has-focus
                                    ? Tokens.focus-ring-width : 0px;
                                border-color: Tokens.color-ring-muted;

                                Typography {
                                    x: Tokens.spacing-lg;
                                    width: parent.width - 2 * Tokens.spacing-lg;
                                    height: parent.height;
                                    text: "Wi-Fi";
                                    variant: TextVariant.body-lg;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Switch {
                                    x: parent.width - self.preferred-width - Tokens.spacing-lg;
                                    y: (parent.height - self.preferred-height) / 2;
                                    label: "";
                                    checked: WifiState.enabled;
                                    toggled(value) => {
                                        WifiState.set-enabled(value);
                                    }
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        page-focus.focus();
                                        root.selected-network = 0;
                                        WifiState.set-enabled(!WifiState.enabled);
                                    }
                                }
                            }

                            for network[network-index] in WifiState.networks: Rectangle {
                                width: parent.width;
                                height: 58px;
                                background: network-index + 1 == root.selected-network ? Tokens.color-surface-3 : Tokens.color-surface-2;
                                border-radius: Tokens.radius-sm;
                                border-width: network-index + 1 == root.selected-network && page-focus.has-focus
                                    ? Tokens.focus-ring-width : 0px;
                                border-color: Tokens.color-ring-muted;

                                Typography {
                                    x: Tokens.spacing-lg;
                                    width: parent.width - 2 * Tokens.spacing-lg - 170px;
                                    height: parent.height;
                                    text: network.ssid;
                                    variant: TextVariant.body-lg;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                if network.secured: LucideIcon {
                                    x: parent.width - 140px - Tokens.spacing-lg;
                                    y: (parent.height - self.height) / 2;
                                    icon: IconSet.Lock;
                                    size: 14px;
                                    tint: Tokens.color-muted-foreground;
                                }
                                Typography {
                                    x: parent.width - 120px - Tokens.spacing-lg;
                                    width: 120px;
                                    height: parent.height;
                                    text: WifiState.connecting && WifiState.connecting-ssid == network.ssid ? "Connecting…" :
                                        network.active ? "Connected" :
                                        network.strength >= 0 ? network.strength + "%" : "";
                                    variant: TextVariant.body;
                                    tone: network.active ? TextTone.default : TextTone.muted;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        page-focus.focus();
                                        root.selected-network = network-index + 1;
                                        root.activate-network(network-index + 1);
                                    }
                                }
                            }

                            if WifiState.enabled && WifiState.networks.length == 0: Typography {
                                height: 58px;
                                text: "No networks found.";
                                variant: TextVariant.body;
                                tone: TextTone.muted;
                                vertical-alignment: center;
                            }
                            if !WifiState.enabled: Typography {
                                height: 58px;
                                text: "Wi-Fi is turned off.";
                                variant: TextVariant.body;
                                tone: TextTone.muted;
                                vertical-alignment: center;
                            }
                        }
                        }
                    }
                }

                if root.detail-open && root.wifi-menu: VerticalLayout {
                    padding: Tokens.spacing-xl;
                    spacing: Tokens.spacing-md;

                    Typography {
                        text: root.detail-ssid;
                        variant: TextVariant.title;
                        overflow: elide;
                    }

                    if root.detail-active: VerticalLayout {
                        spacing: Tokens.spacing-md;

                        Typography {
                            text: "Connected to this network.";
                            variant: TextVariant.body;
                            tone: TextTone.muted;
                        }
                        Rectangle {
                            height: 58px;
                            background: Tokens.color-surface-2;
                            border-radius: Tokens.radius-sm;
                            border-width: page-focus.has-focus ? Tokens.focus-ring-width : 0px;
                            border-color: Tokens.color-ring-muted;

                            Typography {
                                x: Tokens.spacing-lg;
                                width: parent.width - 2 * Tokens.spacing-lg;
                                height: parent.height;
                                text: "Disconnect";
                                variant: TextVariant.body-lg;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    page-focus.focus();
                                    WifiState.disconnect();
                                    root.close-menu();
                                }
                            }
                        }
                        Typography {
                            text: "Press Back to return to Wi-Fi.";
                            variant: TextVariant.caption;
                            tone: TextTone.muted;
                        }
                    }

                    if !root.detail-active: VerticalLayout {
                        spacing: Tokens.spacing-md;

                        Typography {
                            text: "Enter the password for this network.";
                            variant: TextVariant.body;
                            tone: TextTone.muted;
                        }
                        Input {
                            password: true;
                            auto-focus: true;
                            placeholder: "Password";
                            accepted(value) => {
                                if (value != "") {
                                    WifiState.connect(root.detail-ssid, value);
                                    root.close-menu();
                                }
                            }
                        }
                        Typography {
                            text: "Press Back to return to Wi-Fi.";
                            variant: TextVariant.caption;
                            tone: TextTone.muted;
                        }
                    }
                }
            }
        }
    }
}
