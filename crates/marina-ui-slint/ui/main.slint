import { Tokens } from "slintcn/theme/tokens.slint";
import { Text as Typography } from "slintcn/components/text.slint";
import { TextVariant, TextTone } from "slintcn/components/text.slint";
import { NavigationItem } from "slintcn/components/navigation-menu.slint";
import { AppShell } from "app-shell.slint";
import { GameCardData } from "card.slint";
import { Shelf, ShelfSkeleton } from "shelf.slint";
import { LibraryPage } from "library.slint";
import { PlatformCardData } from "platform-card.slint";
import { PreviewDetailsData } from "preview-details.slint";

export component MainWindow inherits Window {
    in property <[GameCardData]> games;
    in property <[PlatformCardData]> platforms;
    in property <[GameCardData]> platform-games;
    in-out property <PreviewDetailsData> game-details;
    in-out property <bool> game-details-loading: false;
    in-out property <bool> library-loading: false;

    in property <length> shelf-height;
    in property <bool> loading: true;
    callback viewport-changed(length, length);
    callback cover-context-changed(int);
    callback platform-query(string);
    callback game-selected(string, int);

    in-out property <int> active-tab: 0;
    in-out property <string> search-query;
    property <[NavigationItem]> navigation-items: [
        { label: "Home" },
        { label: "Library" },
        { label: "Collections" },
    ];

    width: 1280px;
    height: 720px;
    title: "Marina";


    changed active-tab => {
        root.cover-context-changed(root.active-tab);
    }

    AppShell {
        navigation-items: root.navigation-items;
        active-tab <=> root.active-tab;
        search-query <=> root.search-query;
        navigate(index) => { root.active-tab = index; }

        if root.active-tab == 0 && root.loading: ShelfSkeleton {
            content-height: root.shelf-height;
        }

        if root.active-tab == 0 && !root.loading: shelf := Shelf {
            title: "Library";
            games: root.games;
            content-height: root.shelf-height;
            viewport-changed(x, width) => { root.viewport-changed(x, width); }
        }

        if root.active-tab == 1: LibraryPage {
            platforms: root.platforms;
            games: root.platform-games;
            details: root.game-details;
            details-loading <=> root.game-details-loading;
            loading <=> root.library-loading;
            platform-query(slug) => { root.platform-query(slug); }
            game-selected(id, index) => { root.game-selected(id, index); }
        }

        if root.active-tab == 2: Rectangle {
            background: transparent;

            Typography {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                text: "Collections are coming soon";
                variant: TextVariant.body-lg;
                tone: TextTone.muted;
            }
        }
    }
}
